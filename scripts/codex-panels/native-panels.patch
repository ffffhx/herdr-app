@@ -0,0 +1,453 @@
+//! Present ordinary forks and parent-owned agents beside their source conversation.
+//! These are display relationships only: side-chat policies and cleanup never apply.
+
+use super::*;
+
+impl App {
+    pub(super) async fn track_split_spawn_notification(
+        &mut self,
+        source: ThreadId,
+        notification: &ServerNotification,
+    ) {
+        use codex_app_server_protocol::{
+            CollabAgentTool, CollabAgentToolCallStatus, SubAgentActivityKind,
+        };
+        if !self.local_settings.workspace_enabled(&self.config) {
+            return;
+        }
+        let item = match notification {
+            ServerNotification::ItemStarted(n) => &n.item.payload,
+            ServerNotification::ItemCompleted(n) => &n.item.payload,
+            _ => return,
+        };
+        // Spawned threads do not always emit thread/started (notably embedded backends).
+        // Both collaboration versions announce their child on the parent's event stream.
+        let children: Vec<_> = match item {
+            ThreadItemPayload::CollabAgentToolCall {
+                tool: CollabAgentTool::SpawnAgent,
+                status: CollabAgentToolCallStatus::Completed,
+                receiver_thread_ids,
+                ..
+            } => receiver_thread_ids
+                .iter()
+                .map(|id| (id.as_str(), None, false))
+                .collect(),
+            ThreadItemPayload::SubAgentActivity {
+                kind: SubAgentActivityKind::Started,
+                agent_thread_id,
+                agent_path,
+                ..
+            } => vec![(agent_thread_id.as_str(), Some(agent_path.clone()), true)],
+            _ => return,
+        };
+        for (id, path, parent_owned) in children {
+            let Ok(child) = ThreadId::from_string(id) else {
+                continue;
+            };
+            if self.pane_parent(child).is_some() || child == source {
+                continue;
+            }
+            self.register_split_thread(source, child);
+            self.upsert_agent_picker_thread(child, None, None, false);
+            if parent_owned {
+                self.agent_navigation.mark_parent_owned(child);
+            }
+            let label = path.clone().unwrap_or_else(|| self.thread_label(child));
+            self.agent_navigation.set_agent_path(child, path);
+            self.sync_agent_picker_thread(child);
+            let parent = self.pane_parent(child);
+            if let Some(pane) = self.sidebars.get_mut(&parent) {
+                pane.set_chat_name(child, label);
+            }
+            // Replay events that beat the parent's spawn acknowledgement without changing focus.
+            let store = Arc::clone(&self.ensure_thread_channel(child).store);
+            let store = store.lock().await;
+            if let Some(companion) = self.side_companions.get_mut(&child) {
+                for event in store.snapshot().events {
+                    if let ThreadBufferedEvent::Notification(notification) = event {
+                        companion.apply_notification(&notification, &store, || {
+                            self.chat_widget.new_status_indicator()
+                        });
+                    }
+                }
+            }
+        }
+    }
+
+    pub(super) fn pane_parent(&self, id: ThreadId) -> Option<ThreadId> {
+        self.split_threads
+            .get(&id)
+            .copied()
+            .or_else(|| self.side_threads.get(&id).map(|side| side.parent_thread_id))
+    }
+
+    pub(super) fn active_pane_parent(&self) -> Option<ThreadId> {
+        self.current_displayed_thread_id()
+            .and_then(|id| self.pane_parent(id))
+    }
+
+    pub(super) fn register_split_thread(&mut self, source: ThreadId, child: ThreadId) {
+        if !self.local_settings.workspace_enabled(&self.config)
+            || source == child
+            || self.split_threads.contains_key(&child)
+            || self.side_threads.contains_key(&child)
+        {
+            return;
+        }
+        // Descendants share the original main column, without changing their real parent.
+        let parent = self.pane_parent(source).unwrap_or(source);
+        self.split_threads.insert(child, parent);
+        let cwd = self.chat_widget.config_ref().cwd.clone();
+        self.side_companions
+            .entry(child)
+            .or_insert_with(|| SideCompanion::empty(cwd));
+        let active = self.current_displayed_thread_id();
+        let keep_chooser = self.sidebar_parent() == Some(parent)
+            && self.chooser_focus() == Some(sidebar::PaneFocus::Sidebar);
+        let pane = self.sidebars.entry(Some(parent)).or_default();
+        pane.peer_ready(child);
+        // An automatic spawn must never move focus away from a draft or approval.
+        if active == Some(parent) && !keep_chooser {
+            pane.show(
+                sidebar::SidebarContent::Chat(child),
+                sidebar::PaneFocus::Main,
+            );
+        }
+        self.chat_widget.request_redraw();
+    }
+
+    pub(super) async fn attach_split_fork(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        source: ThreadId,
+        forked: crate::app_server_session::AppServerStartedThread,
+    ) -> Result<()> {
+        let child = forked.session.thread_id;
+        if forked.blocks_direct_input {
+            self.agent_navigation.mark_parent_owned(child);
+        }
+        if forked.task_tools_available {
+            app_server.remember_task_tool_thread(child);
+        }
+        self.register_split_thread(source, child);
+        let parent = self.pane_parent(child);
+        if let Some(pane) = self.sidebars.get_mut(&parent) {
+            pane.set_chat_name(
+                child,
+                forked
+                    .session
+                    .thread_name
+                    .clone()
+                    .unwrap_or_else(|| "Fork".into()),
+            );
+        }
+        let channel = self.ensure_thread_channel(child);
+        channel.backend_id = Some(app_server.backend_id());
+        channel
+            .store
+            .lock()
+            .await
+            .set_session(forked.session, forked.turns);
+        self.upsert_agent_picker_thread(child, None, None, false);
+        self.sync_agent_picker_thread(child);
+        self.select_agent_thread(tui, app_server, child).await
+    }
+
+    pub(super) async fn close_split_pane(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        child: ThreadId,
+    ) -> Result<()> {
+        let Some(parent) = self.split_threads.get(&child).copied() else {
+            return Ok(());
+        };
+        if self.current_displayed_thread_id() == Some(child) {
+            self.select_agent_thread(tui, app_server, parent).await?;
+            if self.current_displayed_thread_id() != Some(parent) {
+                return Ok(());
+            }
+        }
+        // Keep the relationship and native subscriptions so closing a view cannot stop work.
+        if let Some(pane) = self.sidebars.get_mut(&Some(parent)) {
+            pane.remove_chat(child, crate::app_server_session::SideChatStorage::Temporary);
+        }
+        tui.frame_requester().schedule_frame();
+        Ok(())
+    }
+}
