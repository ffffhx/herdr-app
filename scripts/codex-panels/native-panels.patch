diff --git a/codex-rs/tui/src/app/herdr_fork.rs b/codex-rs/tui/src/app/herdr_fork.rs
new file mode 100644
index 0000000..b80ad9d
--- /dev/null
+++ b/codex-rs/tui/src/app/herdr_fork.rs
@@ -0,0 +1,177 @@
+//! Forks launched from a local Herdr pane get their own terminal and backend.
+//! Use Herdr's existing CLI; no window/model API or terminal parent-child link is added.
+
+use super::*;
+use serde_json::Value;
+use serde_json::json;
+use tokio::process::Command;
+
+fn source_pane(layout: &Value, terminal: &str) -> Option<String> {
+    let mut matches = layout["spaces"]
+        .as_array()?
+        .iter()
+        .filter(|space| space["machine"].is_null())
+        .flat_map(|space| space["tabs"].as_array().into_iter().flatten())
+        .flat_map(|tab| tab["terminals"].as_array().into_iter().flatten())
+        .filter(|pane| pane["terminal"].as_str() == Some(terminal))
+        .filter_map(|pane| pane["pane"].as_str());
+    let pane = matches.next()?.to_owned();
+    matches.next().is_none().then_some(pane)
+}
+
+async fn herdr(args: &[String]) -> Result<Value> {
+    let mut command = Command::new("herdr-app");
+    command.args(args).kill_on_drop(true);
+    // Herdr CLI requests are background IPC, not new console windows.
+    #[cfg(windows)]
+    command.creation_flags(0x08000000);
+    let output = tokio::time::timeout(Duration::from_secs(15), command.output())
+        .await
+        .map_err(|_| {
+            color_eyre::eyre::eyre!(
+                "Herdr did not confirm the request. Inspect its panes before retrying."
+            )
+        })??;
+    let value: Value = serde_json::from_slice(&output.stdout)?;
+    if !output.status.success() || value.get("error").is_some() {
+        color_eyre::eyre::bail!("Herdr request failed: {value}");
+    }
+    Ok(value)
+}
+
+fn launch_argv(binary: &str, home: &str, args: Vec<String>) -> Vec<String> {
+    if cfg!(windows) {
+        let quote = |value: &str| format!("'{}'", value.replace('\'', "''"));
+        let command = std::iter::once(binary.to_string())
+            .chain(args)
+            .map(|arg| quote(&arg))
+            .collect::<Vec<_>>()
+            .join(" ");
+        vec![
+            "powershell.exe".into(),
+            "-NoLogo".into(),
+            "-NoProfile".into(),
+            "-Command".into(),
+            format!(
+                "$env:CODEX_HOME = {}; & {command}; exit $LASTEXITCODE",
+                quote(home)
+            ),
+        ]
+    } else {
+        [
+            vec!["env".into(), format!("CODEX_HOME={home}"), binary.into()],
+            args,
+        ]
+        .concat()
+    }
+}
+
+impl App {
+    /// Return false only before any mutation, when the source isn't a local Herdr pane.
+    pub(super) async fn fork_in_herdr(
+        &mut self,
+        source: ThreadId,
+        name: Option<&str>,
+    ) -> Result<bool> {
+        // Unit tests must never contact a developer's real Herdr window.
+        if cfg!(test) {
+            return Ok(false);
+        }
+        if !matches!(self.app_server_target, AppServerTarget::Embedded)
+            || !self.local_settings.workspace_enabled(&self.config)
+        {
+            return Ok(false);
+        }
+        let Ok(terminal) = std::env::var("HC_TERMINAL_ID") else {
+            return Ok(false);
+        };
+        if terminal.len() < 2
+            || !terminal.starts_with('t')
+            || !terminal[1..].chars().all(|c| c.is_ascii_alphanumeric())
+        {
+            return Ok(false);
+        }
+        let Ok(layout) = herdr(&["ls".into()]).await else {
+            return Ok(false);
+        };
+        let Some(pane) = source_pane(&layout, &terminal) else {
+            return Ok(false);
+        };
+        let config = self.chat_widget.config_ref();
+        let mut args = vec![
+            "--no-daemon".into(),
+            "fork".into(),
+            source.to_string(),
+            "--cd".into(),
+            config.cwd.to_string_lossy().into_owned(),
+            "--model".into(),
+            self.chat_widget.current_model().to_string(),
+            "-c".into(),
+            format!(
+                "model_provider={}",
+                serde_json::to_string(&config.model_provider_id)?
+            ),
+        ];
+        if let Some(effort) = self.chat_widget.current_reasoning_effort() {
+            args.extend([
+                "-c".into(),
+                format!("model_reasoning_effort={}", serde_json::to_string(&effort)?),
+            ]);
+        }
+        if let Some(name) = name {
+            args.extend(["--fork-name".into(), name.into()]);
+        }
+        let argv = launch_argv(
+            &std::env::current_exe()?.to_string_lossy(),
+            &config.codex_home.to_string_lossy(),
+            args,
+        );
+        let result = herdr(&[
+            "do".into(),
+            "pane.split".into(),
+            json!({"direction":"right","pane":pane,"argv":argv}).to_string(),
+        ])
+        .await?;
+        if result["terminal"].as_str().is_none() || result["pane"].as_str().is_none() {
+            color_eyre::eyre::bail!(
+                "Herdr did not return the new pane. Inspect its panes before retrying."
+            );
+        }
+        // The new CLI performs the native fork itself. No second writer is started
+        // on a thread owned by this backend, and this TUI keeps its original chat.
+        self.chat_widget
+            .add_info_message("Fork opened in the Codex pane on the right.".into(), None);
+        Ok(true)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn herdr_fork_targets_the_source_terminal_not_the_active_tab() {
+        let layout = json!({"spaces":[{"machine":null,"tabs":[{"active":true,"terminals":[{"terminal":"t9","pane":"wrong"}]},{"terminals":[{"terminal":"t3","pane":"source"}]}]}]});
+        assert_eq!(source_pane(&layout, "t3").as_deref(), Some("source"));
+        assert_eq!(source_pane(&layout, "t8"), None);
+    }
+    #[test]
+    fn herdr_fork_does_not_guess_duplicate_or_remote_panes() {
+        let layout = json!({"spaces":[{"machine":"remote","tabs":[{"terminals":[{"terminal":"t3","pane":"remote"}]}]}]});
+        assert_eq!(source_pane(&layout, "t3"), None);
+        let layout = json!({"spaces":[{"machine":null,"tabs":[{"terminals":[{"terminal":"t3","pane":"one"},{"terminal":"t3","pane":"two"}]}]}]});
+        assert_eq!(source_pane(&layout, "t3"), None);
+    }
+    #[cfg(windows)]
+    #[test]
+    fn herdr_fork_quotes_windows_names_and_paths_as_data() {
+        let argv = launch_argv(
+            "C:\\O'Brien\\codex.exe",
+            "C:\\home's",
+            vec!["fork".into(), "--fork-name".into(), "name'; $(exit)".into()],
+        );
+        assert_eq!(
+            argv.last().unwrap(),
+            "$env:CODEX_HOME = 'C:\\home''s'; & 'C:\\O''Brien\\codex.exe' 'fork' '--fork-name' 'name''; $(exit)'; exit $LASTEXITCODE"
+        );
+    }
+}
