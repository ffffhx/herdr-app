+                sender_thread_id: parent.to_string(),
+                receiver_thread_ids: vec![first.to_string()],
+                prompt: None,
+                model: None,
+                reasoning_effort: None,
+                agents_states: Default::default(),
+            },
+            ThreadItemPayload::SubAgentActivity {
+                id: "v2-spawn".into(),
+                kind: SubAgentActivityKind::Started,
+                agent_thread_id: second.to_string(),
+                agent_path: "/root/second".into(),
+                model: None,
+                reasoning_effort: None,
+            },
+        ];
+        for item in items {
+            let notification = ServerNotification::ItemCompleted(ItemCompletedNotification {
+                item: ThreadItem::untimed(item),
+                thread_id: parent.to_string(),
+                turn_id: "parent-turn".into(),
+                content_token_count: None,
+                completed_at_ms: 0,
+            });
+            app.enqueue_thread_notification(parent, notification.clone())
+                .await?;
+            app.enqueue_thread_notification(parent, notification)
+                .await?;
+        }
+        assert_eq!(app.current_displayed_thread_id(), Some(parent));
+        assert_eq!(app.sidebar().unwrap().live_chats(), &[first, second]);
+        assert!(!app.agent_navigation.is_parent_owned(first));
+        assert!(app.agent_navigation.is_parent_owned(second));
+        assert_eq!(
+            app.sidebar().unwrap().chat_name(second),
+            Some("/root/second")
+        );
+        let companion = app.side_companions.get_mut(&first).unwrap();
+        companion.flush_answer();
+        assert!(!companion.cells.is_empty());
+        assert!(app.side_threads.is_empty());
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn automatic_spawn_preserves_focused_sidebar_picker() -> Result<()> {
+        let mut app = Box::pin(make_test_app()).await;
+        enable_side_retention(&mut app)?;
+        let parent = ThreadId::new();
+        let child = ThreadId::new();
+        app.primary_thread_id = Some(parent);
+        app.active_thread_id = Some(parent);
+        app.sidebar_mut().show(
+            sidebar::SidebarContent::Chooser,
+            sidebar::PaneFocus::Sidebar,
+        );
+        app.register_split_thread(parent, child);
+        assert_eq!(app.current_displayed_thread_id(), Some(parent));
+        assert_eq!(app.chooser_focus(), Some(sidebar::PaneFocus::Sidebar));
+        assert_eq!(app.sidebar().unwrap().live_chats(), &[child]);
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn split_registration_respects_workspace_setting() -> Result<()> {
+        let mut app = Box::pin(make_test_app()).await;
+        app.config.features.disable(Feature::TuiWorkspace)?;
+        app.register_split_thread(ThreadId::new(), ThreadId::new());
+        assert!(app.split_threads.is_empty());
+        assert!(app.side_companions.is_empty());
+        Ok(())
+    }
+}
